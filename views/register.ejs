<%- include('partials/header') %>
<h1>Create your patient account</h1>
<p class="lead">You only need to register once. Your details are used to identify you when you book.</p>
<% if (errors.length) { %>
  <div class="box error"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
<% } %>
<form method="post" action="/register" class="card form">
  <div class="row2">
    <label>Given name <input name="given_name" value="<%= form.given_name || '' %>" required></label>
    <label>Family name <input name="family_name" value="<%= form.family_name || '' %>" required></label>
  </div>
  <div class="row2">
    <label>Date of birth <input type="date" name="dob" value="<%= form.dob || '' %>" required></label>
    <label>Mobile <input name="mobile" placeholder="04xxxxxxxx" value="<%= form.mobile || '' %>" required></label>
  </div>
  <div class="row2">
    <label>Email <input type="email" name="email" value="<%= form.email || '' %>" required></label>
    <label>Medicare number <input name="medicare_no" placeholder="10 digits" value="<%= form.medicare_no || '' %>" required></label>
  </div>
  <label>Password <input type="password" name="password" minlength="8" required></label>
  <button type="submit">Register</button>
  <p class="small">Already have an account? <a href="/login">Sign in</a></p>
</form>
<%- include('partials/footer') %>
